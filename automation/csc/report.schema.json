{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:maaltamerelle:csc:evidence-report:1.0",
  "title": "MaaltaMerelle CSC phase-1 evidence report",
  "type": "object",
  "description": "Read-only collection of existing, potentially untrusted report evidence. Schema validity alone does not prove source provenance, authorize work, establish scientific validity or enable any Slurm operation. Semantic checks enforce source references, IDs, times, metrics, checksum bases and MODERATE review policy.",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "document_type",
    "repository",
    "repository_id",
    "branch",
    "report_id",
    "run_id",
    "manifest_fingerprint",
    "commit_sha",
    "observed_at_utc",
    "reader_version",
    "parser_version",
    "sources",
    "jobs",
    "technical_qa",
    "input_artifacts",
    "output_artifacts",
    "missing_files",
    "diagnostics",
    "scientific_review_state",
    "needs_review",
    "review_reasons"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "document_type": {
      "type": "string",
      "const": "csc_evidence_report"
    },
    "repository": {
      "type": "string",
      "const": "annasuuronen/MaaltaMerelle"
    },
    "repository_id": {
      "type": "integer",
      "const": 1407101587
    },
    "branch": {
      "type": "string",
      "const": "baseline-no-structures"
    },
    "report_id": {
      "$ref": "#/$defs/uuid"
    },
    "run_id": {
      "$ref": "#/$defs/uuid"
    },
    "manifest_fingerprint": {
      "$ref": "#/$defs/sha256"
    },
    "commit_sha": {
      "$ref": "#/$defs/commit_sha"
    },
    "observed_at_utc": {
      "$ref": "#/$defs/utc_datetime"
    },
    "reader_version": {
      "$ref": "#/$defs/identifier64"
    },
    "parser_version": {
      "type": "string",
      "const": "existing_reports/v1"
    },
    "sources": {
      "type": "array",
      "minItems": 0,
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "jobs": {
      "type": "array",
      "minItems": 0,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/job"
      }
    },
    "technical_qa": {
      "type": "object",
      "description": "Technical QA remains independent of scheduler completion, scientific review and human authorization.",
      "additionalProperties": false,
      "required": [
        "status",
        "checks"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "PASS",
            "FAIL",
            "INCOMPLETE",
            "NOT_RUN"
          ],
          "description": "Technical extraction/check status only. PASS never means scientific validity or authorization to continue hydrology."
        },
        "checks": {
          "type": "array",
          "minItems": 0,
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/technical_check"
          }
        }
      }
    },
    "input_artifacts": {
      "type": "array",
      "minItems": 0,
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "output_artifacts": {
      "type": "array",
      "minItems": 0,
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "missing_files": {
      "type": "array",
      "minItems": 0,
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/identifier64"
      }
    },
    "diagnostics": {
      "type": "object",
      "description": "MODERATE and positive-threshold/no-component observations require review under the semantic validator. Counts are report evidence, not manufactured components or routes.",
      "additionalProperties": false,
      "required": [
        "test_id",
        "positive_threshold_no_component_lakes"
      ],
      "properties": {
        "test_id": {
          "$ref": "#/$defs/identifier64"
        },
        "positive_threshold_no_component_lakes": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "scientific_review_state": {
      "type": "string",
      "enum": [
        "NOT_ASSESSED",
        "REVIEW_REQUIRED"
      ],
      "description": "No scientific approval/PASS state exists in this phase-1 contract."
    },
    "needs_review": {
      "type": "boolean",
      "const": true,
      "description": "Always true in phase 1, including technically passing reports. This does not grant permission to run subsequent stages."
    },
    "review_reasons": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/identifier64"
      }
    }
  },
  "$defs": {
    "identifier64": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "uuid": {
      "type": "string",
      "format": "uuid",
      "minLength": 36,
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "commit_sha": {
      "type": "string",
      "minLength": 40,
      "maxLength": 40,
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "utc_datetime": {
      "type": "string",
      "format": "date-time",
      "minLength": 20,
      "maxLength": 30,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$",
      "description": "UTC timestamp ending in Z; unknown source timezones must not be guessed."
    },
    "storage_ref": {
      "type": "object",
      "description": "A location reference is data, not an instruction, command or filesystem permission.",
      "additionalProperties": false,
      "required": [
        "root_id",
        "relative_path"
      ],
      "properties": {
        "root_id": {
          "type": "string",
          "const": "CSC_HYDRO_4BBF22B"
        },
        "relative_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[A-Za-z0-9_-][A-Za-z0-9._-]*(/[A-Za-z0-9_-][A-Za-z0-9._-]*)*$",
          "description": "Relative safe ASCII segments beneath the trusted root registry entry. No absolute paths, dot segments, globs or shell syntax. Runtime must also reject symlink/root escapes."
        }
      }
    },
    "checksum_basis": {
      "type": "string",
      "enum": [
        "MEASURED",
        "REPORTED",
        "EXPECTED",
        "UNKNOWN"
      ],
      "description": "MEASURED is calculated from the exact bytes read; REPORTED is a source claim; EXPECTED is a comparison target. Reported/expected raster hashes are not freshly measured raster evidence."
    },
    "evidence_ref": {
      "type": "object",
      "description": "Source identity plus a bounded CSV/log/JSON location. Contents remain untrusted data.",
      "additionalProperties": false,
      "required": [
        "source_id",
        "locator"
      ],
      "properties": {
        "source_id": {
          "$ref": "#/$defs/identifier64"
        },
        "locator": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      }
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 0,
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/evidence_ref"
      }
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "value",
        "unit"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/identifier64"
        },
        "value": {
          "type": "number",
          "description": "Finite JSON numeric metric. Strict parsing must reject NaN and infinity."
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "storage_ref",
        "sha256",
        "checksum_basis",
        "availability",
        "size_bytes"
      ],
      "properties": {
        "source_id": {
          "$ref": "#/$defs/identifier64"
        },
        "storage_ref": {
          "$ref": "#/$defs/report_storage_ref"
        },
        "sha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "checksum_basis": {
          "$ref": "#/$defs/checksum_basis"
        },
        "availability": {
          "type": "string",
          "enum": [
            "AVAILABLE",
            "MISSING",
            "NOT_CHECKED",
            "UNREADABLE",
            "OUT_OF_SCOPE"
          ],
          "description": "MISSING requires inspected absence within an allowed root; failed access or unavailable connectivity is not proof of absence."
        },
        "size_bytes": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 5242880
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "job": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "job_id",
        "array_task_id",
        "step_id",
        "scheduler_state",
        "scheduler_state_raw",
        "exit_code",
        "started_at_utc",
        "ended_at_utc",
        "evidence_refs"
      ],
      "properties": {
        "job_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16,
          "pattern": "^[1-9][0-9]{0,15}$"
        },
        "array_task_id": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "step_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/identifier64"
            },
            {
              "type": "null"
            }
          ]
        },
        "scheduler_state": {
          "type": "string",
          "enum": [
            "PENDING",
            "RUNNING",
            "COMPLETED",
            "FAILED",
            "TIMEOUT",
            "CANCELLED",
            "OUT_OF_MEMORY",
            "NODE_FAIL",
            "PREEMPTED",
            "UNKNOWN",
            "NOT_SUBMITTED"
          ],
          "description": "Historical scheduler evidence, independent of exit code, technical QA and scientific review."
        },
        "scheduler_state_raw": {
          "type": "string",
          "minLength": 0,
          "maxLength": 256
        },
        "exit_code": {
          "anyOf": [
            {
              "type": "object",
              "description": "Slurm status:signal; runtime verifies that raw and parsed numbers agree.",
              "additionalProperties": false,
              "required": [
                "status",
                "signal",
                "raw"
              ],
              "properties": {
                "status": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 255
                },
                "signal": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 127
                },
                "raw": {
                  "type": "string",
                  "minLength": 3,
                  "maxLength": 7,
                  "pattern": "^[0-9]{1,3}:[0-9]{1,3}$"
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "started_at_utc": {
          "anyOf": [
            {
              "$ref": "#/$defs/utc_datetime"
            },
            {
              "type": "null"
            }
          ]
        },
        "ended_at_utc": {
          "anyOf": [
            {
              "$ref": "#/$defs/utc_datetime"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence_refs": {
          "$ref": "#/$defs/evidence_refs"
        }
      }
    },
    "technical_check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "check_id",
        "scope",
        "status",
        "assessment",
        "metrics",
        "evidence_refs"
      ],
      "properties": {
        "check_id": {
          "$ref": "#/$defs/identifier64"
        },
        "scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "status": {
          "type": "string",
          "enum": [
            "PASS",
            "FAIL",
            "INCOMPLETE",
            "NOT_RUN"
          ],
          "description": "Technical extraction/check status only. PASS never means scientific validity or authorization to continue hydrology."
        },
        "assessment": {
          "type": "string",
          "enum": [
            "REPORTED_ONLY",
            "VERIFIED_FROM_REPORTS",
            "NOT_ASSESSED"
          ],
          "description": "A source PASS claim is REPORTED_ONLY until explicitly checked against bound source evidence. Report verification does not verify scientific validity."
        },
        "metrics": {
          "type": "array",
          "minItems": 0,
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/metric"
          }
        },
        "evidence_refs": {
          "$ref": "#/$defs/evidence_refs"
        }
      }
    },
    "artifact": {
      "type": "object",
      "description": "Separate expected targets, source-reported hashes and hashes actually observed from artifact bytes. Phase 1 must not promote a reported raster hash into an observed one.",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "storage_ref",
        "sha256_expected",
        "sha256_reported",
        "sha256_observed",
        "evidence_refs"
      ],
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/identifier64"
        },
        "storage_ref": {
          "$ref": "#/$defs/storage_ref"
        },
        "sha256_expected": {
          "anyOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "sha256_reported": {
          "anyOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "sha256_observed": {
          "type": "null",
          "description": "Reserved for a future approved artifact reader. Phase 1 never reads artifact raster bytes; preserve external measurements as sha256_reported."
        },
        "evidence_refs": {
          "$ref": "#/$defs/evidence_refs"
        }
      }
    },
    "report_storage_ref": {
      "type": "object",
      "description": "Read-only small reports and historical job-ID files; no raster reads or execution.",
      "additionalProperties": false,
      "required": [
        "root_id",
        "relative_path"
      ],
      "properties": {
        "root_id": {
          "type": "string",
          "const": "CSC_HYDRO_4BBF22B"
        },
        "relative_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^(?:[A-Za-z0-9_-][A-Za-z0-9._-]*/)*(?:[A-Za-z0-9_-][A-Za-z0-9._-]*\\.(?:log|txt|csv|json|jobid)|jobid|slurm_jobid)$",
          "description": "Relative safe ASCII segments beneath the trusted root registry entry. No absolute paths, dot segments, globs or shell syntax. Runtime must also reject symlink/root escapes."
        }
      }
    }
  }
}
